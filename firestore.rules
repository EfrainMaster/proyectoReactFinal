rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /productos/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();

      function isAdmin() {
        return request.auth != null && request.auth.token.admin == true;
      }

      function validProduct(data) {
        return data.keys().hasAll([
            'nombre',
            'categoria',
            'precio',
            'descripcion',
            'imagen'
          ])
          && data.keys().hasOnly([
            'nombre',
            'categoria',
            'precio',
            'descripcion',
            'imagen'
          ])
          && data.nombre is string
          && data.nombre.size() > 0
          && data.nombre.size() <= 120
          && data.categoria is string
          && data.categoria.size() > 0
          && data.categoria.size() <= 80
          && data.precio is number
          && data.precio > 0
          && data.descripcion is string
          && data.descripcion.size() <= 500
          && data.imagen is string;
      }
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
